{
  "name": "@handfish/effstate-react",
  "version": "0.0.6",
  "description": "React hooks for effstate-v4 state machines",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "effect": "^3.0.0",
    "@handfish/effstate-v4": "^0.0.6",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "effect": "^3.19.12",
    "@handfish/effstate-v4": "workspace:*",
    "react": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.2.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/handfish/effstate.git",
    "directory": "packages/effstate-react"
  },
  "keywords": [
    "state-machine",
    "effect",
    "react",
    "hooks",
    "typescript"
  ]
}
